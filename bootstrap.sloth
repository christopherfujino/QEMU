#!/usr/bin/env sloth

# from:
#   - https://wiki.archlinux.org/title/KVM
#   - https://wiki.archlinux.org/title/QEMU

let localArchImagePath = 'arch.qcow2'
let localArchImageShaPath = 'arch.qcow2.SHA256'
let localDriveImagePath = 'drive.raw'
let qemuBinary = 'qemu-system-x86_64'

func testKVM() {
  # test for CPU hardware support
  with ($env = $env.merge({'LC_ALL': 'C.UTF-8'})) {
    'lscpu' | 'grep Virtualization'!
  }

  # test for kernel support
  # - zgrep will grep a compressed file
  # - only 'y' or 'm' values mean module is available
  ['zgrep', 'CONFIG_KVM=[ym]', '/proc/config.gz']!

  # test modules are loaded
  'lsmod' | 'grep kvm'!
}

# TODO: setup an overlay storage image:
# - https://wiki.archlinux.org/title/QEMU#Overlay_storage_images
func bootstrapDisk() {
  if not File(localDriveImagePath).exists() {
    # Using `dd` would be faster specifically for 'raw'...
    ['qemu-img', 'create',
      # qemu image format, 'qcow2' (copy on write) is more storage-efficient
      '-f', 'raw',
      localDriveImagePath,
      '10G',
    ]!
  }
}

func downloadIfNotPresent(remotePath, localPath) {
  if File(localPath).exists() {
    print("not downloading ${localPath} because it already exists")
    return
  }

  ['curl', '-L', remotePath, '-o', localPath]!
}

func bootstrapArch() {
  downloadIfNotPresent(
    #'https://mirrors.ocf.berkeley.edu/archlinux/iso/2026.11.01/archlinux-2026.11.01-x86_64.iso',
    'https://gitlab.archlinux.org/archlinux/arch-boxes/-/package_files/13560/download',
    localArchImagePath,
  )
  #downloadIfNotPresent(
  #  'https://gitlab.archlinux.org/archlinux/arch-boxes/-/package_files/13561/download',
  #  localArchImageShaPath,
  #)

  let actualSha = (['sha256sum', localArchImagePath]&!).stdout.split(' ')[0]
  let correctSha = (<- localArchImageShaPath).split(' ')[0]
  if actualSha != correctSha {
    throw "${actualSha} != ${correctSha}"
  }
}

func testDeps() {
  let deps = [
    # qemu-base
    'qemu-img',
    # tigervnc
    'vncviewer',
  ]

  for dep in deps {
    ['which', dep]!
  }
}

with ($cwd = $scriptDir) {
  testDeps()
  testKVM()
  bootstrapDisk()
  bootstrapArch()

  print('Successfully bootstrapped environment!')
}
